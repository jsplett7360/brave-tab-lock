{
  "manifest_version": 3,
  "name": "Tab Lock",
  "version": "0.1.0",
  "description": "Locks your browser behind a PIN and hides your open tabs. Everything stays on your device.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "tabGroups", "idle", "alarms"],
  "incognito": "spanning",
  "background": { "service_worker": "src/sw.js", "type": "module" },
  "action": {
    "default_title": "Lock now",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "commands": {
    "lock-now": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "MacCtrl+Shift+L" },
      "description": "Lock the browser now"
    }
  },
  "options_page": "src/pages/options.html",
  "storage": { "managed_schema": "managed_schema.json" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'"
  }
}
